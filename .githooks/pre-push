#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

npm run verify

if [ -x "$repo_root/apps/api/.venv/Scripts/python.exe" ]; then
  python_bin="$repo_root/apps/api/.venv/Scripts/python.exe"
elif [ -x "$repo_root/apps/api/.venv/bin/python" ]; then
  python_bin="$repo_root/apps/api/.venv/bin/python"
else
  echo "Ambiente Python ausente. Crie apps/api/.venv e instale .[dev]." >&2
  exit 1
fi

cd "$repo_root/apps/api"
mkdir -p "$repo_root/tmp"
"$python_bin" -m pytest -p no:cacheprovider --basetemp "$repo_root/tmp/pytest-pre-push"
"$python_bin" -m ruff check .
"$python_bin" -m mypy app
